{
    "workspace": ["packages/*"],
    "nodeModulesDir": "auto",
    "tasks": {
        "build": "deno task --cwd=packages/zesty build && deno task --cwd=packages/islands build && deno task --cwd=packages/plugin-vite build",
        "version:patch": "deno run --allow-read --allow-write ./scripts/bump-version.ts patch",
        "version:minor": "deno run --allow-read --allow-write ./scripts/bump-version.ts minor",
        "version:major": "deno run --allow-read --allow-write ./scripts/bump-version.ts major",
        "publish:patch": "deno task version:patch && deno publish --allow-all",
        "publish:minor": "deno task version:minor && deno publish --allow-all",
        "publish:major": "deno task version:major && deno publish --allow-all"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1"
    },
    "publish": {
        "include": [
            "src/**",
            "LICENSE",
            "README.md",
            "mod.ts",
            "deno.json"
        ],
        "exclude": ["www", ".gitignore", "!dist/**"]
    }
}