  "imports": {
    "@std/path": "jsr:@std/path@^1.1.4",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.1.18",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
    "autoprefixer": "npm:autoprefixer@^10.4.23",
    "lightningcss": "npm:lightningcss@^1.30.2",
    "postcss-nested": "npm:postcss-nested@^7.0.2",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.5.0",
    "@vite": "npm:vite@^7.1.3",
    "vite": "npm:vite@^7.3.1"
  }
