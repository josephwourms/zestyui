{
  "name": "@zesty/ui",
  "version": "0.1.3",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./vite": "./vite.ts"
  },
  "tasks": {
    "build": "vite build"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
